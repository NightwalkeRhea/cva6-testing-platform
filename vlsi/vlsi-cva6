def connect_test_mode_signals(x: HammerTool) -> bool:
    if x.get_setting("vlsi.core.synthesis_tool") == "hammer.synthesis.dc":
        # Connect top level black box's signals (unconnected) to scan signals
        x.append("set pins [get_pins -hierarchical *test_en_i*]")
        x.append("foreach_in_collection pin $pins {")
        x.append("disconnect_net [all_connected $pin] $pin")
        x.append("connect_pin -from [get_port test_mode ] -to $pin -port_name test_en_i_custom_i")
        x.append("}")

        x.append("set pins [get_pins -hierarchical *test_mode_i*]")
        x.append("foreach_in_collection pin $pins {")
        x.append("disconnect_net [all_connected $pin] $pin")
        x.append("connect_pin -from [get_port test_mode ] -to $pin -port_name test_mode_i_custom_i")
        x.append("}")

        x.append("disconnect_net [all_connected gated_clock_debug_clock_gate/test_en] gated_clock_debug_clock_gate/test_en")
        x.append("connect_pin -from [get_port test_mode ] -to gated_clock_debug_clock_gate/test_en -port_name test_en_i_custom")

        x.append("set_dft_drc_rules -ignore {TEST-504}")
        x.append("set_dft_drc_rules -ignore {TEST-505}")
        # Why Do I Get TEST-504 or TEST-505 Violations on Test Model Segments?
        # There is an unexpected inversion on the reset line between the top-level and the block-level. 
        x.append("disconnect_net [all_connected system/tile_prci_domain/element_reset_domain_cva6_tile/core/rst] system/tile_prci_domain/element_reset_domain_cva6_tile/core/rst")
        x.append("connect_pin -from [get_port reset_io ] -to system/tile_prci_domain/element_reset_domain_cva6_tile/core/rst -port_name reset_core_i")

    return True 


