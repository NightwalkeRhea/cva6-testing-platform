<?xml version="1.0" encoding="utf-8"?>
<!-- Genome for an ALU-oriented SBST on rv64: the uGP3 constraints file itself.

     What uGP3 writes from this file is one function, sbst_body, which the
     scaffolding in genome/sbst/ calls and whose return value it stores as the
     signature. The section prologue and epilogue below are that function's
     frame; the two subSections are what evolves inside it: 'init' seeds every
     free register once, 'body' is a sequence of macros, one instruction each.

     Only register-register and immediate arithmetic: no memory with a computed
     address and no branch to a computed target, so an individual cannot crash
     or fail to return. After every instruction its result is folded into s11,
     the accumulator the epilogue returns: without the fold most of what the
     program computed would be dead before it could be observed.

     uGP3 accepts three mistakes here without a word: a non-decimal integer
     range, a minimum above its maximum, an expression without a trailing
     newline. evosbst stops on each of them, and docs/ugp3-errors.md has the
     rest. genome/rv64_alu.toml is the same genome in the short form, for
     campaigns that set [genome] file to it. -->
<constraints id="ALU">
  <typeDefinitions>
    <!-- Registers the evolved code may write. Caller-saved only, so the frame
         has nothing to preserve for them. a0 is included: the epilogue
         overwrites it. -->
    <item type="constant" name="reg">
      <value>t0</value>
      <value>t1</value>
      <value>t2</value>
      <value>t3</value>
      <value>t4</value>
      <value>t5</value>
      <value>t6</value>
      <value>a0</value>
      <value>a1</value>
      <value>a2</value>
      <value>a3</value>
      <value>a4</value>
      <value>a5</value>
      <value>a6</value>
      <value>a7</value>
    </item>
    <!-- The opcodes, one list per instruction format. div and rem are left
         out: they run in another unit, so they add cycles and no coverage. -->
    <item type="constant" name="op_reg">
      <value>add</value>
      <value>sub</value>
      <value>sll</value>
      <value>slt</value>
      <value>sltu</value>
      <value>xor</value>
      <value>srl</value>
      <value>sra</value>
      <value>or</value>
      <value>and</value>
      <value>addw</value>
      <value>subw</value>
      <value>sllw</value>
      <value>srlw</value>
      <value>sraw</value>
    </item>
    <item type="constant" name="op_imm12">
      <value>addi</value>
      <value>slti</value>
      <value>sltiu</value>
      <value>xori</value>
      <value>ori</value>
      <value>andi</value>
      <value>addiw</value>
    </item>
    <item type="constant" name="op_shamt6">
      <value>slli</value>
      <value>srli</value>
      <value>srai</value>
    </item>
    <item type="constant" name="op_shamt5">
      <value>slliw</value>
      <value>srliw</value>
      <value>sraiw</value>
    </item>
    <item type="constant" name="op_upper">
      <value>lui</value>
    </item>
  </typeDefinitions>
  <commentFormat>#<value /></commentFormat>
  <identifierFormat>n<value /></identifierFormat>
  <labelFormat><value />:</labelFormat>
  <uniqueTagFormat><value /></uniqueTagFormat>
  <prologue id="globalPrologue" />
  <epilogue id="globalEpilogue" />
  <sections>
    <section id="sbst" prologueEpilogueCompulsory="false">
      <!-- The frame of sbst_body: save s11, start the accumulator at 0, and at
           the end return it in a0. Every <expression> ends with a newline:
           uGP3 copies the text out literally. -->
      <prologue id="sectionPrologue">
        <expression>    .option nopic
    .text
    .align 2
    .globl sbst_body
    .type sbst_body, @function
sbst_body:
    addi sp, sp, -16
    sd s11, 0(sp)
    li s11, 0
</expression>
      </prologue>
      <epilogue id="sectionEpilogue">
        <expression>    mv a0, s11
    ld s11, 0(sp)
    addi sp, sp, 16
    ret
    .size sbst_body, .-sbst_body
</expression>
      </epilogue>
      <subSections>
        <!-- Exactly once: a 32-bit random value in every free register, so the
             body starts from data rather than from zeros. -->
        <subSection id="init" maxOccurs="1" minOccurs="1" maxReferences="0">
          <prologue id="initPrologue"/>
          <epilogue id="initEpilogue"/>
          <macros maxOccurs="1" minOccurs="1" averageOccurs="1" sigma="1">
            <macro id="seedRegs">
              <expression>    li t0, 0x<param ref="k0"/>
    li t1, 0x<param ref="k1"/>
    li t2, 0x<param ref="k2"/>
    li t3, 0x<param ref="k3"/>
    li t4, 0x<param ref="k4"/>
    li t5, 0x<param ref="k5"/>
    li t6, 0x<param ref="k6"/>
    li a0, 0x<param ref="k7"/>
    li a1, 0x<param ref="k8"/>
    li a2, 0x<param ref="k9"/>
    li a3, 0x<param ref="k10"/>
    li a4, 0x<param ref="k11"/>
    li a5, 0x<param ref="k12"/>
    li a6, 0x<param ref="k13"/>
    li a7, 0x<param ref="k14"/>
</expression>
              <parameters>
                <item type="bitArray" length="32" base="hex" name="k0"/>
                <item type="bitArray" length="32" base="hex" name="k1"/>
                <item type="bitArray" length="32" base="hex" name="k2"/>
                <item type="bitArray" length="32" base="hex" name="k3"/>
                <item type="bitArray" length="32" base="hex" name="k4"/>
                <item type="bitArray" length="32" base="hex" name="k5"/>
                <item type="bitArray" length="32" base="hex" name="k6"/>
                <item type="bitArray" length="32" base="hex" name="k7"/>
                <item type="bitArray" length="32" base="hex" name="k8"/>
                <item type="bitArray" length="32" base="hex" name="k9"/>
                <item type="bitArray" length="32" base="hex" name="k10"/>
                <item type="bitArray" length="32" base="hex" name="k11"/>
                <item type="bitArray" length="32" base="hex" name="k12"/>
                <item type="bitArray" length="32" base="hex" name="k13"/>
                <item type="bitArray" length="32" base="hex" name="k14"/>
              </parameters>
            </macro>
          </macros>
        </subSection>
        <!-- The evolving part. The number of macros is a gene, and it is also
             what an evaluation costs. uGP3 draws the initial count around
             averageOccurs with this sigma, clamped to [minOccurs, maxOccurs];
             from then on insertion and removal mutations move it one macro at
             a time. The floor is low so that short programs are on the table,
             the spread wide so that generation 0 explores the length at all:
             tests/lengths.py shows what it actually draws. A macro's weight is
             how often it is picked relative to the others. -->
        <subSection id="body" maxOccurs="1" minOccurs="1" maxReferences="0">
          <prologue id="bodyPrologue"/>
          <epilogue id="bodyEpilogue"/>
          <macros minOccurs="16" maxOccurs="384" averageOccurs="128" sigma="80.0">
            <macro id="reg" weight="9">
              <expression>    <param ref="op"/> <param ref="dst"/>, <param ref="s1"/>, <param ref="s2"/>
    add s11, s11, <param ref="dst"/>
</expression>
              <parameters>
                <item type="definedType" ref="op_reg" name="op"/>
                <item type="definedType" ref="reg" name="dst"/>
                <item type="definedType" ref="reg" name="s1"/>
                <item type="definedType" ref="reg" name="s2"/>
              </parameters>
            </macro>
            <macro id="imm12" weight="4">
              <expression>    <param ref="op"/> <param ref="dst"/>, <param ref="s1"/>, <param ref="imm"/>
    add s11, s11, <param ref="dst"/>
</expression>
              <parameters>
                <item type="definedType" ref="op_imm12" name="op"/>
                <item type="definedType" ref="reg" name="dst"/>
                <item type="definedType" ref="reg" name="s1"/>
                <!-- Decimal only: "0x7ff" would be read as 0. -->
                <item type="integer" minimum="-2048" maximum="2047" name="imm"/>
              </parameters>
            </macro>
            <macro id="shamt6" weight="3">
              <expression>    <param ref="op"/> <param ref="dst"/>, <param ref="s1"/>, 0b<param ref="sh"/>
    add s11, s11, <param ref="dst"/>
</expression>
              <parameters>
                <item type="definedType" ref="op_shamt6" name="op"/>
                <item type="definedType" ref="reg" name="dst"/>
                <item type="definedType" ref="reg" name="s1"/>
                <item type="bitArray" length="6" base="bin" name="sh"/>
              </parameters>
            </macro>
            <macro id="shamt5" weight="2">
              <expression>    <param ref="op"/> <param ref="dst"/>, <param ref="s1"/>, 0b<param ref="sh"/>
    add s11, s11, <param ref="dst"/>
</expression>
              <parameters>
                <item type="definedType" ref="op_shamt5" name="op"/>
                <item type="definedType" ref="reg" name="dst"/>
                <item type="definedType" ref="reg" name="s1"/>
                <item type="bitArray" length="5" base="bin" name="sh"/>
              </parameters>
            </macro>
            <macro id="upper" weight="1">
              <expression>    <param ref="op"/> <param ref="dst"/>, 0x<param ref="imm20"/>
    add s11, s11, <param ref="dst"/>
</expression>
              <parameters>
                <item type="definedType" ref="op_upper" name="op"/>
                <item type="definedType" ref="reg" name="dst"/>
                <item type="bitArray" length="20" base="hex" name="imm20"/>
              </parameters>
            </macro>
          </macros>
        </subSection>
      </subSections>
    </section>
  </sections>
</constraints>
