<?xml version="1.0" encoding="utf-8" ?>
<!-- uGP3 population settings: how the search runs. The genome, what an
     individual may contain, is the constraints file the campaign names in
     [genome]. A key in the campaign's [ga], or on the command line
     (set ga.lambda=8), overrides the value here for that run; the run keeps
     the settings it actually used in input/population.settings.xml. -->
<parameters type="enhanced">
  <!-- Population size, and how many individuals generation 0 starts from. -->
  <mu value="30"/>
  <nu value="60"/>
  <!-- Genetic operators applied per generation: each yields one or two
       offspring, so a generation is between lambda and 2 x lambda new
       individuals. Keep it a multiple of the individuals evaluated at once
       (cores.total / cores.per_ind). -->
  <lambda value="48"/>
  <!-- Stop at whichever comes first. -->
  <maximumGenerations value="30"/>
  <maximumEvaluations value="100000"/>
  <maximumTime hours="168" />
  <!-- Mutation strength, self-adapted; inertia is how slowly it moves. -->
  <sigma value="0.9"/>
  <inertia value="0.9"/>
  <!-- Generations an individual survives, and how many of the best always do. -->
  <maximumAge value="3"/>
  <eliteSize value="0"/>
  <!-- Fitness scaling of identical individuals: 0 leaves clones alone. -->
  <cloneScalingFactor value="0.0"/>
  <invalidateFitnessAfterGeneration value="0"/>
  <!-- Parent selection: a tournament of tau individuals, tau self-adapted
       within [tauMin, tauMax]. -->
  <selection type="tournamentWithFitnessHole" tau="2" tauMin="1" tauMax="1" fitnessHole="0" />
  <!-- Filled in by evosbst for every run: the width of the fitness, the
       constraints file and the evaluator are how uGP3 talks to it. -->
  <fitnessParameters value="2"/>
  <constraints value="constraints.xml"/>
  <evaluation>
    <concurrentEvaluations value="48" />
    <removeTempFiles value="false" />
    <evaluatorPathName value="evalclient.py"/>
    <evaluatorInputPathName value="individual%s"/>
    <evaluatorOutputPathName value="fitness.output"/>
  </evaluation>
  <!-- The operators in use. No scanMutation: one application breeds a child
       per value of a parameter, near-identical programs that each cost a
       fault campaign. -->
  <operators default="none">
    <operator ref="onePointImpreciseCrossover"/>
    <operator ref="twoPointImpreciseCrossover"/>
    <operator ref="uniformCrossover"/>
    <operator ref="singleParameterAlterationMutation"/>
    <operator ref="alterationMutation"/>
    <operator ref="insertionMutation"/>
    <operator ref="removalMutation"/>
    <operator ref="replacementMutation"/>
    <operator ref="swapMutation"/>
    <operator ref="randomizer"/>
  </operators>
</parameters>
